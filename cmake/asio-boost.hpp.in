#pragma once

/// \file
/// Centralised include for Boost.ASIO, providing namespace aliases used throughout libzeep.

#if ZEEP_BOOST_ASIO_STANDALONE
# define BOOST_ASIO_STANDALONE 1
#endif

// This header is missing in some asio versions
#include <utility> // NOLINT(unused-includes)

#ifdef __GNUC__
# pragma GCC diagnostic push
# pragma GCC diagnostic ignored "-Wsuggest-override"
#endif
// IWYU pragma: begin_exports
#include <boost/asio.hpp>
#include <boost/asio/ssl.hpp>
// IWYU pragma: end_exports
#ifdef __GNUC__
# pragma GCC diagnostic pop
#endif

/// \brief Namespace alias for the Boost.ASIO library
namespace asio_ns = ::boost::asio;
/// \brief Namespace alias for the Boost.System error code namespace used by Boost.ASIO
namespace asio_system_ns = ::boost::system;
