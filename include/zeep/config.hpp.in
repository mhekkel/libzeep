/// \file
/// Generic configuration file, contains defines and (probably obsolete) stuff for msvc

#pragma once

/// \def HTTP_HAS_UNIX_DAEMON
/// \brief Whether the http::daemon class supports UNIX fork/exec backgrounding.
///
/// The http::daemon class can use fork/exec to spawn a
/// process in the background. That's not going to work
/// on Windows for now.

#ifndef HTTP_HAS_UNIX_DAEMON
# cmakedefine01 HTTP_HAS_UNIX_DAEMON
#endif

/// \def WEBAPP_USES_RESOURCES
/// \brief Whether the webapp can use the mrc resource compiler to load files.
///
/// The webapp class in libzeep can use resources to load files.
/// In this case you need the resource compiler 'mrc' obtainable
/// from https://forge.hekkelman.net/maarten/mrc

#ifndef WEBAPP_USES_RESOURCES
# cmakedefine01 WEBAPP_USES_RESOURCES
#endif

/// \def USE_RSRC
/// \brief Whether the mrc resource compiler is available for embedding files.
///
/// We can use resources to store the contents of a docroot e.g.
/// which makes web applications really portable. However, for
/// this feature we need a working mrc
/// (https://forge.hekkelman.net/maarten/mrc) and that is limited to
/// Windows and operating systems using the ELF executable format.

#ifndef USE_RSRC
# cmakedefine01 USE_RSRC
#endif

// NOLINTBEGIN(modernize-macro-to-enum)
/// \def LIBZEEP_VERSION
/// \brief The current version of libzeep as a string
#define LIBZEEP_VERSION "@LIBZEEP_VERSION@"
/// \def LIBZEEP_VERSION_MAJOR
/// \brief The major version number component of libzeep
#define LIBZEEP_VERSION_MAJOR @LIBZEEP_VERSION_MAJOR@
/// \def LIBZEEP_VERSION_MINOR
/// \brief The minor version number component of libzeep
#define LIBZEEP_VERSION_MINOR @LIBZEEP_VERSION_MINOR@
/// \def LIBZEEP_VERSION_PATCH
/// \brief The patch version number component of libzeep
#define LIBZEEP_VERSION_PATCH @LIBZEEP_VERSION_PATCH@
// NOLINTEND(modernize-macro-to-enum)

// Some warnings that we don't like in MSVC:
#if defined(_MSC_VER)

# define _CRT_SECURE_NO_WARNINGS 1
# define NOMINMAX 1

# pragma warning(disable : 4996) // stl copy()
# pragma warning(disable : 4100) // unreferenced formal parameter
# pragma warning(disable : 4101) // unreferenced local variable

#endif
